generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  WAREHOUSE
  SALES
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  PAID
  CANCELLED
}

enum CashDirection {
  IN
  OUT
}

enum PayMethodKind {
  IMMEDIATE
  CHECK
}

enum PriceList {
  RETAIL
  WHOLESALE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CheckDirection {
  IN
  OUT
}

enum CheckStatus {
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
}

enum DocKind {
  QUOTATION
  SALES_ORDER
  PURCHASE_ORDER
}

enum DocStatus {
  DRAFT
  OPEN
  CONVERTED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(SALES)
  permissions  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cashTransactions CashTransaction[]
  salesInvoices    SalesInvoice[]    @relation("SalesCreatedBy")
  purchaseInvoices PurchaseInvoice[] @relation("PurchaseCreatedBy")
  shifts           CashierShift[]
  warehouseLinks   UserWarehouse[]
  periodsClosed    FiscalPeriod[]    @relation("PeriodClosedBy")
  periodLogs       FiscalPeriodLog[] @relation("PeriodLogUser")
  orgNodeId        String?
  orgNode          OrgNode?          @relation(fields: [orgNodeId], references: [id], onDelete: SetNull)
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  location    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockBalances          StockBalance[]
  stockMovements         StockMovement[]
  salesInvoices          SalesInvoice[]
  purchaseInvoices       PurchaseInvoice[]
  salesReturns           SalesReturn[]
  purchaseReturns        PurchaseReturn[]
  replacementReturns     SalesReturn[]       @relation("ReturnReplacementWarehouse")
  oldBatteriesStocked    OldBattery[]        @relation("OldBatteryStockWarehouse")
  oldBatteryReplacements OldBattery[]        @relation("OldBatteryReplacementWarehouse")
  transfersFrom          StockTransfer[]     @relation("TransferFrom")
  transfersTo            StockTransfer[]     @relation("TransferTo")
  locations              WarehouseLocation[]
  productLocations       ProductLocation[]
  productWarehouses      ProductWarehouse[]
  customerWarehouses     CustomerWarehouse[]
  supplierWarehouses     SupplierWarehouse[]
  userLinks              UserWarehouse[]
  documents              TradeDocument[]
}

/// حقول اختيارية عامة على الأصناف (ماركة، لون…) — الصنف اللي مش محتاجها يسيبها فاضية
model ProductCustomField {
  id         String    @id @default(cuid())
  name       String    @unique
  label      String
  fieldType  FieldType @default(TEXT)
  options    String?
  isRequired Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  values ProductFieldValue[]
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  unit           String   @default("قطعة")
  costPrice      Float    @default(0)
  salePrice      Float    @default(0)
  minStock       Float    @default(0)
  description    String?
  barcode        String?  @unique
  brand          String?
  /// مقاس البطارية (مثل 55 أمبير / 70 أمبير)
  batterySize    String?
  categoryId     String?
  wholesalePrice Float    @default(0)
  packUnit       String?
  packSize       Float    @default(1)
  imageFile      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category               Category?             @relation(fields: [categoryId], references: [id])
  fieldValues            ProductFieldValue[]
  customerPrices         CustomerPrice[]
  locations              ProductLocation[]
  warehouses             ProductWarehouse[]
  documentLines          TradeDocumentLine[]
  stockBalances          StockBalance[]
  stockMovements         StockMovement[]
  salesLines             SalesInvoiceLine[]
  purchaseLines          PurchaseInvoiceLine[]
  salesReturnLines       SalesReturnLine[]
  purchaseReturnLines    PurchaseReturnLine[]
  transferLines          StockTransferLine[]
  replacementReturns     SalesReturn[]         @relation("ReturnReplacementProduct")
  oldBatteries           OldBattery[]          @relation("OldBatteryProduct")
  oldBatteriesStocked    OldBattery[]          @relation("OldBatteryStockProduct")
  oldBatteryReplacements OldBattery[]          @relation("OldBatteryReplacementProduct")
}

/// أصناف مربوطة بمخزن معيّن. لو الصنف مفيهوش صفوف هنا يبقى متاح لكل المخازن.
model ProductWarehouse {
  id          String @id @default(cuid())
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model ProductFieldValue {
  id        String @id @default(cuid())
  productId String
  fieldId   String
  value     String

  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   ProductCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldId])
}

model StockBalance {
  id          String @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Float  @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

model StockMovement {
  id          String            @id @default(cuid())
  warehouseId String
  productId   String
  type        StockMovementType
  quantity    Float
  unitCost    Float             @default(0)
  reference   String?
  note        String?
  createdAt   DateTime          @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model StockTransfer {
  id              String   @id @default(cuid())
  number          String   @unique
  fromWarehouseId String
  toWarehouseId   String
  note            String?
  createdAt       DateTime @default(now())

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Float

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Float    @default(0)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  payments         Payment[]
  checks           BankCheck[]
  documents        TradeDocument[]     @relation("DocSupplier")
  warehouses       SupplierWarehouse[]
  scrapSales       ScrapSale[]
  oldBatteries     OldBattery[]
}

model Customer {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  phone          String?
  email          String?
  address        String?
  balance        Float           @default(0)
  creditLimit    Float           @default(0)
  priceList      PriceList       @default(RETAIL)
  notes          String?
  checks         BankCheck[]
  customerPrices CustomerPrice[]
  documents      TradeDocument[] @relation("DocCustomer")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  salesInvoices SalesInvoice[]
  salesReturns  SalesReturn[]
  receipts      Receipt[]
  warehouses    CustomerWarehouse[]
  oldBatteries  OldBattery[]
}

/// عملاء مربوطين بمخزن. من غير صفوف = ظاهر لكل المخازن.
model CustomerWarehouse {
  id          String @id @default(cuid())
  customerId  String
  warehouseId String

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([customerId, warehouseId])
  @@index([warehouseId])
}

/// موردين مربوطين بمخزن. من غير صفوف = ظاهر لكل المخازن.
model SupplierWarehouse {
  id          String @id @default(cuid())
  supplierId  String
  warehouseId String

  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([supplierId, warehouseId])
  @@index([warehouseId])
}

model CashAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  accountType String   @default("CASH")
  balance     Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions CashTransaction[]
  payments     Payment[]
  receipts     Receipt[]
  shifts       CashierShift[]
  expenses     Expense[]
  checks       BankCheck[]
  payMethod    PayMethod?
  salesReturns SalesReturn[]
  scrapSales   ScrapSale[]
}

model PayMethod {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  kind          PayMethodKind @default(IMMEDIATE)
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  cashAccountId String?       @unique
  createdAt     DateTime      @default(now())

  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
}

model CashTransaction {
  id            String        @id @default(cuid())
  accountId     String
  direction     CashDirection
  amount        Float
  description   String
  paymentMethod String        @default("")
  reference     String?
  createdById   String?
  createdAt     DateTime      @default(now())

  account   CashAccount @relation(fields: [accountId], references: [id])
  createdBy User?       @relation(fields: [createdById], references: [id])
}

model SalesInvoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  warehouseId   String
  status        InvoiceStatus @default(DRAFT)
  invoiceDate   DateTime      @default(now())
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  paidAmount    Float         @default(0)
  paymentMethod String        @default("")
  taxRate       Float         @default(0)
  /// بطارية خردة مع الفاتورة (وزن × سعر الكيلو يُضاف للإجمالي)
  hasScrap      Boolean       @default(false)
  scrapKg       Float         @default(0)
  scrapPieces   Float         @default(0)
  scrapPriceKg  Float         @default(0)
  scrapAmount   Float         @default(0)
  /// SCRAP خردة عادية · WARRANTY_SWAP زبون ضمان دفع فرق وخد جديدة
  scrapKind     String        @default("SCRAP")
  shiftId       String?
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id])
  shift        CashierShift?      @relation(fields: [shiftId], references: [id])
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy    User?              @relation("SalesCreatedBy", fields: [createdById], references: [id])
  lines        SalesInvoiceLine[]
  receipts     Receipt[]
  returns      SalesReturn[]
  oldBatteries OldBattery[]

  @@index([invoiceDate])
  @@index([status])
  @@index([customerId])
}

model SalesInvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  productId String
  quantity  Float
  unitPrice Float
  unitCost  Float  @default(0)
  discount  Float  @default(0)
  total     Float

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
}

model PurchaseInvoice {
  id            String        @id @default(cuid())
  number        String        @unique
  supplierId    String
  warehouseId   String
  status        InvoiceStatus @default(DRAFT)
  invoiceDate   DateTime      @default(now())
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  paidAmount    Float         @default(0)
  paymentMethod String        @default("")
  /// قيمة خردة مبيعة لنفس المورد ومخصومة من الفاتورة (الإجمالي بعد خصمها)
  scrapAmount   Float         @default(0)
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier  Supplier              @relation(fields: [supplierId], references: [id])
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  createdBy User?                 @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  lines     PurchaseInvoiceLine[]
  payments  Payment[]
  returns   PurchaseReturn[]
  scrapSale ScrapSale?

  @@index([invoiceDate])
  @@index([status])
  @@index([supplierId])
}

model PurchaseInvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  productId   String
  quantity    Float
  unitCost    Float
  discount    Float     @default(0)
  total       Float
  /// بيانات الشحنة — تختلف مع كل شراء (اختياري)
  batchNumber String?
  expiryDate  DateTime?

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
}

model SalesReturn {
  id                     String   @id @default(cuid())
  number                 String   @unique
  salesInvoiceId         String?
  customerId             String?
  /// اسم عميل اختياري (نص حر)
  customerName           String?
  warehouseId            String
  returnDate             DateTime @default(now())
  total                  Float    @default(0)
  notes                  String?
  /// خردة بالوزن/القطع (ينفع بدون صنف)
  scrapKg                Float    @default(0)
  scrapPieces            Float    @default(0)
  /// استهلاك فلوس اختياري → حركة إيراد على الخزنة
  consumptionAmount      Float    @default(0)
  cashAccountId          String?
  /// استبدال ببطارية جديدة من مخزن آخر
  giveReplacement        Boolean  @default(false)
  replacementProductId   String?
  replacementWarehouseId String?
  replacementQty         Float    @default(0)
  createdAt              DateTime @default(now())

  salesInvoice         SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id])
  customer             Customer?         @relation(fields: [customerId], references: [id])
  warehouse            Warehouse         @relation(fields: [warehouseId], references: [id])
  cashAccount          CashAccount?      @relation(fields: [cashAccountId], references: [id])
  replacementProduct   Product?          @relation("ReturnReplacementProduct", fields: [replacementProductId], references: [id])
  replacementWarehouse Warehouse?        @relation("ReturnReplacementWarehouse", fields: [replacementWarehouseId], references: [id])
  lines                SalesReturnLine[]
}

model SalesReturnLine {
  id        String @id @default(cuid())
  returnId  String
  productId String
  quantity  Float
  unitPrice Float
  /// تكلفة سطر البيع الأصلي. فاضي للمرتجع غير المربوط بفاتورة.
  unitCost  Float?
  total     Float

  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
}

model PurchaseReturn {
  id                String   @id @default(cuid())
  number            String   @unique
  purchaseInvoiceId String?
  supplierId        String
  warehouseId       String
  returnDate        DateTime @default(now())
  total             Float    @default(0)
  /// استهلاك بندفعه للمورد على المرتجع: BALANCE على حسابه · CASH دفع فوري
  consumptionFee    Float    @default(0)
  feeSettlement     String?
  feeMethodId       String?
  feeCashAccountId  String?
  notes             String?
  createdAt         DateTime @default(now())

  purchaseInvoice PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id])
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  lines           PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id           String @id @default(cuid())
  returnId     String
  productId    String
  quantity     Float
  unitCost     Float
  total        Float
  /// كمية تم استلامها تاني بعد المرتجع في مخزن جديد
  restockedQty Float  @default(0)

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
}

/// بطارية قديمة دخلت المحل (خردة من فاتورة بيع / ضمان زبون / يدوي).
/// بتتفرز بالليل: خردة · مستعمل · سيرفس · مرتجع ضمان للمورد
model OldBattery {
  id                     String    @id @default(cuid())
  number                 String    @unique
  source                 String
  ownership              String    @default("SHOP")
  productId              String?
  label                  String?
  salesInvoiceId         String?
  customerId             String?
  customerName           String?
  customerPhone          String?
  intakeValue            Float     @default(0)
  receivedAt             DateTime  @default(now())
  productionDate         DateTime?
  ageBand                String?
  condition              String?
  decision               String    @default("PENDING")
  sortedAt               DateTime?
  stockProductId         String?
  stockWarehouseId       String?
  weightKg               Float?
  scrapSaleId            String?
  supplierId             String?
  claimStatus            String?
  sentAt                 DateTime?
  receiverName           String?
  replacementAt          DateTime?
  replacementProductId   String?
  replacementWarehouseId String?
  consumptionFee         Float     @default(0)
  feeSettlement          String?
  feeMethodId            String?
  feeCashAccountId       String?
  deliveredAt            DateTime?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  product              Product?      @relation("OldBatteryProduct", fields: [productId], references: [id], onDelete: SetNull)
  stockProduct         Product?      @relation("OldBatteryStockProduct", fields: [stockProductId], references: [id], onDelete: SetNull)
  replacementProduct   Product?      @relation("OldBatteryReplacementProduct", fields: [replacementProductId], references: [id], onDelete: SetNull)
  stockWarehouse       Warehouse?    @relation("OldBatteryStockWarehouse", fields: [stockWarehouseId], references: [id], onDelete: SetNull)
  replacementWarehouse Warehouse?    @relation("OldBatteryReplacementWarehouse", fields: [replacementWarehouseId], references: [id], onDelete: SetNull)
  salesInvoice         SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier             Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  scrapSale            ScrapSale?    @relation(fields: [scrapSaleId], references: [id], onDelete: SetNull)

  @@index([decision])
  @@index([claimStatus])
  @@index([supplierId])
  @@index([salesInvoiceId])
}

/// بيع خردة بالوزن لمورد. بمياه = خصم نسبة من الوزن.
/// التسوية: INVOICE خصم من فاتورة شراء · CASH استلام فلوس · BALANCE خصم من حساب المورد
model ScrapSale {
  id                String   @id @default(cuid())
  number            String   @unique
  supplierId        String
  saleDate          DateTime @default(now())
  withWater         Boolean  @default(false)
  waterPercent      Float    @default(15)
  grossKg           Float
  netKg             Float
  priceKg           Float
  amount            Float
  settlement        String
  purchaseInvoiceId String?  @unique
  cashAccountId     String?
  paymentMethod     String   @default("")
  notes             String?
  createdAt         DateTime @default(now())

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  cashAccount     CashAccount?     @relation(fields: [cashAccountId], references: [id])
  oldBatteries    OldBattery[]

  @@index([supplierId])
  @@index([saleDate])
}

model Payment {
  id                String   @id @default(cuid())
  number            String   @unique
  supplierId        String
  cashAccountId     String?
  purchaseInvoiceId String?
  amount            Float
  paymentMethod     String   @default("")
  referenceNo       String?
  note              String?
  paidAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  cashAccount     CashAccount?     @relation(fields: [cashAccountId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
}

model Receipt {
  id             String   @id @default(cuid())
  number         String   @unique
  customerId     String
  cashAccountId  String?
  salesInvoiceId String?
  amount         Float
  paymentMethod  String   @default("")
  referenceNo    String?
  note           String?
  shiftId        String?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  cashAccount  CashAccount?  @relation(fields: [cashAccountId], references: [id])
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  shift        CashierShift? @relation(fields: [shiftId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

enum PeriodAction {
  CLOSE
  REOPEN
}

model FiscalPeriod {
  id         String    @id @default(cuid())
  year       Int
  month      Int
  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("PeriodClosedBy", fields: [closedById], references: [id])

  @@unique([year, month])
}

model FiscalPeriodLog {
  id        String       @id @default(cuid())
  year      Int
  month     Int
  action    PeriodAction
  reason    String?
  userId    String
  user      User         @relation("PeriodLogUser", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([year, month])
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique
  scope      String
  userId     String   @default("")
  resourceId String   @default("")
  createdAt  DateTime @default(now())
}

model Sequence {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model CustomerPrice {
  id         String @id @default(cuid())
  customerId String
  productId  String
  price      Float

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model WarehouseLocation {
  id          String @id @default(cuid())
  warehouseId String
  code        String
  name        String

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products  ProductLocation[]

  @@unique([warehouseId, code])
}

model ProductLocation {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  locationId  String

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model UserWarehouse {
  userId      String
  warehouseId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
}

model CashierShift {
  id            String      @id @default(cuid())
  userId        String
  cashAccountId String
  status        ShiftStatus @default(OPEN)
  openingCash   Float
  closingCash   Float?
  expectedCash  Float?
  difference    Float?
  notes         String?
  openedAt      DateTime    @default(now())
  closedAt      DateTime?

  user     User           @relation(fields: [userId], references: [id])
  account  CashAccount    @relation(fields: [cashAccountId], references: [id])
  invoices SalesInvoice[]
  receipts Receipt[]
  expenses Expense[]
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id            String   @id @default(cuid())
  categoryId    String
  accountId     String
  shiftId       String?
  amount        Float
  expenseDate   DateTime @default(now())
  paymentMethod String   @default("")
  notes         String?
  createdAt     DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  account  CashAccount     @relation(fields: [accountId], references: [id])
  shift    CashierShift?   @relation(fields: [shiftId], references: [id])
}

model BankCheck {
  id                String         @id @default(cuid())
  direction         CheckDirection
  checkNumber       String
  bankName          String
  amount            Float
  issueDate         DateTime       @default(now())
  dueDate           DateTime
  status            CheckStatus    @default(PENDING)
  customerId        String?
  supplierId        String?
  accountId         String?
  salesInvoiceId    String?
  purchaseInvoiceId String?
  methodId          String?
  receiptId         String?
  paymentId         String?
  notes             String?
  createdAt         DateTime       @default(now())

  customer Customer?    @relation(fields: [customerId], references: [id])
  supplier Supplier?    @relation(fields: [supplierId], references: [id])
  account  CashAccount? @relation(fields: [accountId], references: [id])
}

model TradeDocument {
  id          String    @id @default(cuid())
  kind        DocKind
  number      String    @unique
  status      DocStatus @default(DRAFT)
  customerId  String?
  supplierId  String?
  warehouseId String?
  docDate     DateTime  @default(now())
  notes       String?
  discount    Float     @default(0)
  taxRate     Float     @default(0)
  total       Float     @default(0)
  convertedId String?
  createdAt   DateTime  @default(now())

  customer  Customer?           @relation("DocCustomer", fields: [customerId], references: [id])
  supplier  Supplier?           @relation("DocSupplier", fields: [supplierId], references: [id])
  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id])
  lines     TradeDocumentLine[]
}

model TradeDocumentLine {
  id         String @id @default(cuid())
  documentId String
  productId  String
  quantity   Float
  unitPrice  Float
  discount   Float  @default(0)
  total      Float

  document TradeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  method    String
  path      String
  status    String   @default("success")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model AppNotification {
  id        String    @id @default(cuid())
  dedupeKey String    @unique
  category  String
  title     String
  body      String
  severity  String    @default("info")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
}

enum OrgKind {
  ADMINISTRATION
  DEPARTMENT
  JOB_TITLE
  STAFF_GROUP
}

model OrgNode {
  id        String   @id @default(cuid())
  kind      OrgKind
  name      String
  code      String?
  subtitle  String?
  levelMark String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   OrgNode?  @relation("OrgParent", fields: [parentId], references: [id])
  children OrgNode[] @relation("OrgParent")
  members  User[]

  @@index([kind])
}

model RecordNote {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  body       String
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  APPROVED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model WorkTask {
  id            String        @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus    @default(PENDING)
  priority      TaskPriority  @default(MEDIUM)
  assigneeId    String?
  assigneeName  String?
  dueDate       DateTime?
  entityType    String?
  entityId      String?
  entityLabel   String?
  createdById   String?
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      TaskComment[]

  @@index([status])
  @@index([assigneeId])
  @@index([entityType, entityId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  body      String
  userId    String?
  userName  String?
  createdAt DateTime @default(now())
  task      WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model SavedReport {
  id         String   @id @default(cuid())
  name       String
  definition String
  ownerId    String?
  ownerName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

model SavedView {
  id        String   @id @default(cuid())
  name      String
  module    String
  query     String
  ownerId   String
  ownerName String?
  createdAt DateTime @default(now())

  @@index([module, ownerId])
}

model Attachment {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  fileName       String
  mimeType       String
  size           Int
  storageName    String
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
}

/// File contents (product images, attachments) so uploads survive hosts with ephemeral disks.
model FileBlob {
  key       String   @id
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model AutomationRule {
  id        String          @id @default(cuid())
  name      String
  trigger   String
  action    String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  runs      AutomationRun[]
}

model AutomationRun {
  id        String         @id @default(cuid())
  ruleId    String
  dedupeKey String         @unique
  summary   String
  createdAt DateTime       @default(now())
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
